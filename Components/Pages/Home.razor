@page "/"
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<SamlOptions> SamlOptionsAccessor

<PageTitle>Overview | Entra SAML Lab</PageTitle>

<div class="page-heading">
    <div>
        <p class="eyebrow accent">Overview</p>
        <h1>Welcome to Entra SAML Lab</h1>
        <p class="page-intro">A controlled workspace for validating your Microsoft Entra ID SAML 2.0 service provider integration.</p>
    </div>
    <span class="status-badge @(IsAuthenticated ? "status-badge-ready" : "status-badge-muted")">
        <span class="status-dot"></span> @(IsAuthenticated ? "Authenticated" : "Not connected")
    </span>
</div>

<section class="hero-panel">
    <div class="hero-copy">
        <span class="hero-kicker">Service provider lab</span>
        <h2>@SamlOptionsAccessor.Value.ApplicationName</h2>
        <p>Prepare, inspect, and validate the protocol details that connect your application to Microsoft Entra ID.</p>
        <a class="button button-primary" href="/auth/login">
            Sign in with Microsoft Entra ID
            <span aria-hidden="true">→</span>
        </a>
        <span class="button-note">
            @(IsAuthenticated ? "You are signed in" : "SAML sign-in is available when an IdP is configured")
        </span>
    </div>
    <div class="hero-visual" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="orbit-core">E</div>
        <span class="orbit-node node-one"></span>
        <span class="orbit-node node-two"></span>
        <span class="orbit-node node-three"></span>
    </div>
</section>

<div class="section-heading">
    <div>
        <p class="eyebrow">Readiness</p>
        <h2>Connection snapshot</h2>
    </div>
    <a class="text-link" href="/configuration">View configuration <span aria-hidden="true">↗</span></a>
</div>

<div class="dashboard-grid">
    <section class="info-card">
        <div class="card-header">
            <div class="card-icon icon-violet" aria-hidden="true">◆</div>
            <span class="status-badge @(IsAuthenticated ? "status-badge-ready" : "status-badge-muted")">
                @(IsAuthenticated ? "Active" : "Pending")
            </span>
        </div>
        <p class="card-label">Authentication status</p>
        <h3>@(IsAuthenticated ? "Authenticated" : "Not Authenticated")</h3>
        <p class="card-description">
            @(IsAuthenticated ? "An active ClaimsPrincipal is available in this session." : "No active ClaimsPrincipal is available in this session.")
        </p>
    </section>

    <section class="info-card">
        <div class="card-header">
            <div class="card-icon icon-cyan" aria-hidden="true">◎</div>
            <span class="status-badge @(HasServiceProviderConfiguration ? "status-badge-ready" : "status-badge-muted")">
                @(HasServiceProviderConfiguration ? "Ready" : "Awaiting setup")
            </span>
        </div>
        <p class="card-label">SAML service provider</p>
        <h3>@(HasServiceProviderConfiguration ? "Configured" : "Not configured")</h3>
        <p class="card-description">
            @(HasServiceProviderConfiguration ? "The public Service Provider values are ready for Identity Provider setup." : "Entity ID, ACS, and metadata values will appear here when configured.")
        </p>
    </section>

    <section class="info-card info-card-wide">
        <div class="card-header">
            <div class="card-icon icon-amber" aria-hidden="true">▣</div>
            <span class="status-badge status-badge-ready">Ready for setup</span>
        </div>
        <p class="card-label">Next step</p>
        <h3>Configure your SAML connection</h3>
        <p class="card-description">The Service Provider is configured. Add the Microsoft Entra Identity Provider values through application configuration to enable sign-in.</p>
        <a class="card-action" href="/configuration">Open configuration <span aria-hidden="true">→</span></a>
    </section>
</div>

@code {
    private bool IsAuthenticated;

    private bool HasServiceProviderConfiguration =>
        SamlOptionsAccessor.Value.HasServiceProviderConfiguration;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        IsAuthenticated = authenticationState.User.Identity?.IsAuthenticated == true;
    }
}